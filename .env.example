# Kopyala: cp .env.example .env   (gerçek ortamda parolaları değiştir)
POSTGRES_USER=esnaf
POSTGRES_PASSWORD=esnaf_dev_password
POSTGRES_DB=esnafdefter

# En az 32 karakter
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TTL=15m
REFRESH_TTL=168h
LOG_LEVEL=info

# Simülatör (varsayılanlar şartnameyle uyumlu: 5 işletme, 3.000 cari, 50.000 hareket)
SIM_SEED=42
SIM_BUSINESSES=5
SIM_CONTACTS=3000
SIM_EVENTS=50000
# Canlı olay akışı aralığı; 0 yazarsanız canlı akış kapanır
SIM_LIVE_INTERVAL=5s

# k6 yük testi
K6_VUS=20
K6_DURATION=30s
